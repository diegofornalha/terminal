# Use Python 3.11 slim image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies including Node.js for Claude Code CLI
RUN apt-get update && apt-get install -y \
    gcc \
    git \
    curl \
    nodejs \
    npm \
    gh \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create data directory and global-settings project
RUN mkdir -p /app/data /app/global-settings /app/scripts

# Copy setup scripts
COPY scripts/setup-mcp.sh /app/scripts/
COPY scripts/docker-entrypoint.sh /app/scripts/
COPY scripts/claude-init-config.sh /app/scripts/
RUN chmod +x /app/scripts/*.sh

# Configure bashrc for better developer experience
RUN echo '\n# Auto-navigate to global-settings project\n\
if [ -d /app/global-settings ]; then\n\
    cd /app/global-settings\n\
fi\n\n\
# Useful aliases\n\
alias proj="cd /app/global-settings"\n\
alias projects="cd /app/projects"\n\
alias claude-auto="/app/scripts/claude-wrapper.sh"\n\n\
# Environment for auto-permissions\n\
export CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=true\n\
export CLAUDE_AUTO_APPROVE_MCP=true' >> /root/.bashrc

# Create symlink for easy access
RUN ln -sf /app/global-settings /root/project

# Configure Git
RUN git config --global user.email "user@claudable.local" && \
    git config --global user.name "Claudable User" && \
    git config --global init.defaultBranch main

# Initialize git repository in global-settings
RUN cd /app/global-settings && \
    git init && \
    echo "# Global Terminal Settings\n\nDefault project for terminal and Claude Code CLI." > README.md && \
    git add . && \
    git commit -m "Initial commit" || true

# Setup MCP Neo4j during build
RUN cd /app/global-settings && \
    git clone https://github.com/AgentesIntegrados/mcp-neo4j-agent-memory.git && \
    cd mcp-neo4j-agent-memory && \
    NODE_ENV=development npm install && \
    npm run build && \
    echo "NEO4J_URI=bolt://claudable-neo4j:7687\nNEO4J_USERNAME=neo4j\nNEO4J_PASSWORD=password\nNEO4J_DATABASE=neo4j" > .env

# Create MCP configuration file
RUN echo '{ \
  "command": "node", \
  "args": ["/app/global-settings/mcp-neo4j-agent-memory/build/index.js"], \
  "env": { \
    "NEO4J_URI": "bolt://claudable-neo4j:7687", \
    "NEO4J_USERNAME": "neo4j", \
    "NEO4J_PASSWORD": "password", \
    "NEO4J_DATABASE": "neo4j" \
  } \
}' > /app/global-settings/mcp-config.json

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV API_PORT=8000
ENV CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS=true
ENV CLAUDE_AUTO_APPROVE_MCP=true

# Expose the port
EXPOSE 8000

# Run the application with custom entrypoint
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]