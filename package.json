{
  "name": "terminal",
  "version": "1.0.0",
  "private": true,
  "description": "Terminal web: PTY com Claude Code via WebSocket",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --raw \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/terminal && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev:web": "npm run dev --workspace apps/web",
    "test:api": "cd apps/terminal && .venv/bin/python -m pytest tests/"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
