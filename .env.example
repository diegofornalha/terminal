# Terminal System - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores

# === API Configuration ===
API_PORT=8000
DATABASE_URL=sqlite:///./data/terminal.db

# === Neo4j Configuration ===
# IMPORTANTE: Sempre gere uma senha forte e única!
# Exemplo de como gerar: openssl rand -base64 16 | tr -d '=' | tr '+/' '-_'
NEO4J_URI=bolt://terminal-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# === MCP Configuration ===
MCP_AUTO_REGISTER=true
MCP_WORKTREE_ISOLATION=true

# === Frontend Configuration ===
WEB_PORT=3005
NEXT_PUBLIC_API_BASE=http://api:8000
NEXT_PUBLIC_WS_BASE=ws://api:8000

# === Docker Configuration ===
NODE_ENV=development
BUILD_TARGET=development